{
  "name": "vfox",
  "version": "0.3.0",
  "private": true,
  "description": "VFox — a lightweight, open-source, telemetry-free anti-detect (fingerprint) browser for Windows, powered by the Camoufox engine.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @vfox/desktop dev",
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm --filter @vfox/desktop build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "kernel:fetch": "camoufox-js fetch",
    "kernel:path": "node scripts/kernel-path.mjs"
  },
  "dependencies": {
    "camoufox-js": "^0.12.0",
    "playwright-core": "1.60.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.2",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  }
}
