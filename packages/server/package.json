    "lint": "biome check src test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "@vfox/core": "workspace:*",
    "@vfox/shared": "workspace:*",
    "@vfox/sync": "workspace:*",
    "fastify": "^5.6.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
