{
  "name": "@vfox/core",
  "version": "0.3.6",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false",
    "test": "tsc -b && tsc -p tsconfig.test.json --noEmit false --outDir .test-build && node test/run-vitest.mjs run --passWithNoTests --root .test-build",
    "lint": "biome check src"
  },
  "dependencies": {
    "@vfox/shared": "workspace:*",
    "adm-zip": "^0.5.16",
    "camoufox-js": "^0.12.0",
    "playwright-core": "1.60.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
