{
  "name": "@vfox/shared",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "//test": "`tsc -b` first so the .mjs tests read a fresh dist; the launcher answers the sandbox's `net use` probe and uses --pool=threads. Same recipe as packages/{server,cli,sync}.",
    "test": "tsc -b && node test/run-vitest.mjs run --passWithNoTests --pool=threads",
    "lint": "biome check src test"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
