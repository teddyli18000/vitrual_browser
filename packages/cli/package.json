  },
  "dependencies": {
    "@vfox/core": "workspace:*",
    "@vfox/server": "workspace:*",
    "@vfox/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
